PUBLIC_URL=https://dance-sequence-builder.duckdns.org
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DB_PATH=/data/dance.sqlite
PORT=8080
TRUST_PROXY=1

# Google: серверный OAuth Client ID и secret; для входа Drive API не нужен.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Почта: SMTP-провайдер для кодов входа. Не включать тестовый вывод кодов в production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Домен для Caddy, без https://. Должен соответствовать PUBLIC_URL.
APP_DOMAIN=dance-sequence-builder.duckdns.org
FRONTEND_URL=https://molostov-a.github.io/dance-sequence-builder/
